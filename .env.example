# Governance Layer Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=8083
NODE_ENV=development

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p3dx_governance
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak service-account auth for calls to the FL receivers (:8080 / :8090).
# gov_layer fetches a client-credentials token here and sends it as a Bearer token
# the receivers validate via introspection. Create a confidential client with
# "Service accounts enabled" and paste its secret. Blank CLIENT_SECRET => fall back
# to the legacy PUSH_AUTH_TOKEN shared secret.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=gov-layer
KEYCLOAK_CLIENT_SECRET=
# PUSH_AUTH_TOKEN=

# APD service URL — required to fetch dataset/infra policies (data_url,
# is_private, rules) and provider forms. Without this set, every policy fetch
# fails (logged as a warning, never blocks) and contracts are generated with
# an empty data_url even when the data-provider set one via "Set Policy".
APD_BASE_URL=http://localhost:8082

# SMTP config for the private-dataset FYI notice to the data provider (see
# services.sendPrivateDatasetNotice). Blank => notice is skipped with a
# logged warning; fill these in with a real SMTP server to enable it.
SMTP_HOST=
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# TEE/SMPC legacy general pathway (POST /contract — general_contract.go).
ORCH_PRIVATE_KEY=./keys/orch_private_key.pem
STORE_KEY=Zv58PzoUX9R11fHNHksA4NkvV6X+2WjL
STORE_PATH=./data/contracts.db

# TEE orchestrator (POST /v1/tee/... — tee_orchestrator.go). Real values for
# the pre-provisioned p3dx-anon-tee confidential VM in the TEE resource group.
TEE_AZURE_RG=TEE
TEE_VM_NAME=p3dx-anon-tee
TEE_VM_IP=40.80.82.162
TEE_ENCLAVE_PORT=4000
TEE_START_TIMEOUT_MS=300000
TEE_POLL_INTERVAL_MS=5000
TEE_OUTPUT_TIMEOUT_MS=60000

TEE_ATTESTATION_REQUIRED=true
# TODO: confirm the actual issuer once /attest runs once — the rejection
# error will report the guest's real iss claim if this default is wrong
# for the VM's region (centralindia).
TEE_MAA_ISSUERS=https://sharedeus2.eus2.attest.azure.net
TEE_ATTESTATION_TTL_MS=900000
TEE_ATTEST_TIMEOUT_MS=180000
TEE_CLOCK_LEEWAY_MS=60000

# Participant-VM IP registry (POST/GET /vm-registry... — vm_registry.go),
# called by terraform/participant-vm after creating each VM. Blank disables
# the X-VM-Registry-Token check (fine for local dev); set this to require it.
# VM_REGISTRY_TOKEN=

# Contract signing (FL, TEE, SMPC): gov_layer signs each contract hash with its
# own key pair (generated at GOV_SIGNING_KEY_PATH on first start), sends it to
# every data provider, and no FL session / TEE / SMPC run starts until each has
# signed that hash; each signature is verified against the provider's
# "public_key" attribute in the platform's own Keycloak (the one p3dx-aaa uses —
# same admin account as its KEYCLOAK_ADMIN_*).
REQUIRE_SIGNED_CONTRACT=true
GOV_SIGNING_KEY_PATH=./keys/governance_signing_key.pem

# FL roster contract validity (Go duration; default 2160h = 90 days). Sets
# each FL contract's lifecycle.valid_until; Flotilla gateway certificates
# expire with it.
FL_CONTRACT_VALIDITY=2160h

# Flotilla join gateway (POST /gateway-certs, GET /governance/ca-cert). The
# governance signing key doubles as a CA; its self-signed certificate is
# generated at GOV_CA_CERT_PATH on first start (and regenerated if the key
# changes). Only a token from the services' Keycloak (KEYCLOAK_JWKS_URL /
# KEYCLOAK_BASE_URL+REALM) issued to ORCHESTRATOR_CLIENT_ID and holding realm
# role ORCHESTRATOR_ROLE may request a gateway certificate. Tokens issued to
# FLOTILLA_VM_CLIENT_ID are refused on every provider-token endpoint.
GOV_CA_CERT_PATH=./keys/governance_ca.pem
ORCHESTRATOR_CLIENT_ID=p3dx-fl-orchestrator
ORCHESTRATOR_ROLE=fl-orchestrator
FLOTILLA_VM_CLIENT_ID=flotilla-vm

# DX catalogue for the job-approval data-provider check. POST
# /job/approval/data-provider must carry the data provider's own dev Keycloak
# token (Bearer); it is validated against DATA_PROVIDER_JWKS_URL (default: the
# USER_KEYCLOAK_BASE_URL/REALM certs above), must hold DATA_PROVIDER_ROLE, and
# is used to look each of their datasets up at CATALOGUE_BASE_URL/item?id=.
CATALOGUE_BASE_URL=https://v2.dev.iudx.io/controlplane/iudx/v2/cat
CATALOGUE_TIMEOUT_MS=10000

# Temporary: approve a job on its data-provider approval alone, without
# waiting for the infra-provider approval. Remove (or set true) to require both.
REQUIRE_INFRA_APPROVAL=true
# DATA_PROVIDER_JWKS_URL=https://v2.dev.iudx.io/auth/realms/iudx-v2/protocol/openid-connect/certs
