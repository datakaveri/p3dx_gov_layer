# Governance Layer Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=8083
NODE_ENV=development

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p3dx_governance
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak service-account auth for calls to the FL receivers (:8080 / :8090).
# gov_layer fetches a client-credentials token here and sends it as a Bearer token
# the receivers validate via introspection. Create a confidential client with
# "Service accounts enabled" and paste its secret. Blank CLIENT_SECRET => fall back
# to the legacy PUSH_AUTH_TOKEN shared secret.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=gov-layer
KEYCLOAK_CLIENT_SECRET=
# PUSH_AUTH_TOKEN=

# Forms (output-owner submissions, data-provider forms) live in aaa now. aaa
# pushes each one here after storing it — see internal/httpapi/forms_ingest.go.
# Optional shared secret aaa must send as X-Forms-Push-Token; blank disables the check.
# FORMS_PUSH_TOKEN=

# ---------------------------------------------------------------------------
# TEE orchestrator (POST /v1/tee/provision etc. — internal/httpapi/tee_orchestrator.go)
# ---------------------------------------------------------------------------
# This is the service p3dx-apd points TEE_ORCHESTRATOR_URL at. The confidential
# VM is pre-provisioned (cloned from a known-good SEV-SNP guest); the
# orchestrator starts and deallocates it rather than creating it, so these name
# an existing VM. Provisioning fails with TEE_NOT_CONFIGURED if RG/name are unset.
#
# Requires an authenticated `az` CLI on the gov_layer host — the lifecycle calls
# shell out to `az vm start|deallocate|get-instance-view`.
#
# WARNING: contract signatures are NOT verified on this API yet, so anyone who
# can reach it can start a workload. Keep it on an internal network.
TEE_AZURE_RG=TEE
TEE_VM_NAME=p3dx-anon-tee
TEE_VM_IP=
# Enclave manager port inside the CVM (Flask/gunicorn).
TEE_ENCLAVE_PORT=4000
# Overrides the URL built from TEE_VM_IP + TEE_ENCLAVE_PORT (e.g. behind a proxy).
# TEE_ENCLAVE_BASE_URL=
# A cold confidential VM takes ~1 min to boot before its manager answers.
TEE_START_TIMEOUT_MS=300000
TEE_POLL_INTERVAL_MS=5000
TEE_OUTPUT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# TEE attestation (internal/services/attestation.go)
# ---------------------------------------------------------------------------
# POST /v1/tee/{id}/run is REFUSED unless the TEE has a fresh verified
# attestation (POST /v1/tee/{id}/attest). Fail-closed by design.
#
# Setting this false turns the CVM into an ordinary VM as far as any trust claim
# goes — the workload still runs, but nothing has proved it runs in a TEE. Local
# development only.
TEE_ATTESTATION_REQUIRED=true

# The trust anchor: MAA endpoints whose assertions are believed. REQUIRED —
# leave it empty and no token can verify, so no run can proceed. The JWKS URL is
# derived from the validated issuer, never from the token's own jku header.
# Must match the region your CVM attests against (the token's `iss` claim).
TEE_MAA_ISSUERS=https://sharedeus2.eus2.attest.azure.net

# Optional: pin the guest's SEV-SNP launch measurement (hex SHA-384) so only the
# expected VM boot state passes. Empty accepts any measurement — still proves
# "a genuine non-debuggable SEV-SNP CVM", but not "the image we expect".
# NOTE: this covers guest firmware/kernel/initrd, NOT the container that runs
# inside. It changes when Azure updates CVM firmware, and /attest then fails
# closed with a got/want diff.
# TEE_EXPECTED_LAUNCH_MEASUREMENT=

# How long one verified attestation authorises runs before re-attestation.
TEE_ATTESTATION_TTL_MS=900000
# Attestation involves a round trip to MAA and is slow.
TEE_ATTEST_TIMEOUT_MS=180000
TEE_CLOCK_LEEWAY_MS=60000
