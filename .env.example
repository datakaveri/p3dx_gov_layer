# Governance Layer Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=8083
NODE_ENV=development

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p3dx_governance
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak service-account auth for calls to the FL receivers (:8080 / :8090).
# gov_layer fetches a client-credentials token here and sends it as a Bearer token
# the receivers validate via introspection. Create a confidential client with
# "Service accounts enabled" and paste its secret. Blank CLIENT_SECRET => fall back
# to the legacy PUSH_AUTH_TOKEN shared secret.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=gov-layer
KEYCLOAK_CLIENT_SECRET=
# PUSH_AUTH_TOKEN=

# APD service URL — required to fetch dataset/infra policies (data_url,
# is_private, rules) and provider forms. Without this set, every policy fetch
# fails (logged as a warning, never blocks) and contracts are generated with
# an empty data_url even when the data-provider set one via "Set Policy".
APD_BASE_URL=http://localhost:8082

# SMTP config for the private-dataset FYI notice to the data provider (see
# services.sendPrivateDatasetNotice). Blank => notice is skipped with a
# logged warning; fill these in with a real SMTP server to enable it.
SMTP_HOST=
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# TEE/SMPC legacy general pathway (POST /contract — general_contract.go).
ORCH_PRIVATE_KEY=./keys/orch_private_key.pem
STORE_KEY=Zv58PzoUX9R11fHNHksA4NkvV6X+2WjL
STORE_PATH=./data/contracts.db

# TEE orchestrator (POST /v1/tee/... — tee_orchestrator.go). Real values for
# the pre-provisioned p3dx-anon-tee confidential VM in the TEE resource group.
TEE_AZURE_RG=TEE
TEE_VM_NAME=p3dx-anon-tee
TEE_VM_IP=40.80.82.162
TEE_ENCLAVE_PORT=4000
TEE_START_TIMEOUT_MS=300000
TEE_POLL_INTERVAL_MS=5000
TEE_OUTPUT_TIMEOUT_MS=60000

TEE_ATTESTATION_REQUIRED=true
# TODO: confirm the actual issuer once /attest runs once — the rejection
# error will report the guest's real iss claim if this default is wrong
# for the VM's region (centralindia).
TEE_MAA_ISSUERS=https://sharedeus2.eus2.attest.azure.net
TEE_ATTESTATION_TTL_MS=900000
TEE_ATTEST_TIMEOUT_MS=180000
TEE_CLOCK_LEEWAY_MS=60000

# Participant-VM IP registry (POST/GET /vm-registry... — vm_registry.go),
# called by terraform/participant-vm after creating each VM. Blank disables
# the X-VM-Registry-Token check (fine for local dev); set this to require it.
# VM_REGISTRY_TOKEN=