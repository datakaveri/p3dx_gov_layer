# Governance Layer Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=8083
NODE_ENV=development

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p3dx_governance
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak service-account auth for calls to the FL receivers (:8080 / :8090).
# gov_layer fetches a client-credentials token here and sends it as a Bearer token
# the receivers validate via introspection. Create a confidential client with
# "Service accounts enabled" and paste its secret. Blank CLIENT_SECRET => fall back
# to the legacy PUSH_AUTH_TOKEN shared secret.
KEYCLOAK_BASE_URL=https://v2.dev.iudx.io/auth
KEYCLOAK_REALM=iudx-v2
KEYCLOAK_CLIENT_ID=gov-layer
KEYCLOAK_CLIENT_SECRET=
# PUSH_AUTH_TOKEN=

# APD service URL — required to fetch dataset/infra policies (data_url,
# is_private, rules) and provider forms. Without this set, every policy fetch
# fails (logged as a warning, never blocks) and contracts are generated with
# an empty data_url even when the data-provider set one via "Set Policy".
APD_BASE_URL=http://localhost:8082

# Key Broker Service for each data provider's contract "trustee" block
# (kbs_url + key_resource_path default/<dataset>-key/<dataset_id>). Blank
# leaves the block out of contracts.
KBS_URL=http://172.17.0.8:30081

# Default result location for every generated contract: parties.user.datablob_url,
# relayed to the workload as RESULT_URL (next to DATASET_URL). Write-only Azure
# SAS (sp=cw) — expires at its se= time, replace it then. Blank leaves it empty.
# Base of a TEE contract's callbackUrl; "/<contract_id>" is appended. Blank
# leaves callbackUrl out of contracts.
CONTRACT_CALLBACK_URL=http://callback-sink.p3dx-system.svc/callbacks

# Run TEE: grpcurl -plaintext -d <sub-contract> COORDINATOR_ADDR
#   kata.coordinator.v1.CoordinatorService/CreateJob (POST /v1/tee/run).
GRPCURL_BIN=/home/saravan/go/bin/grpcurl
COORDINATOR_ADDR=20.219.196.127:30082

# DEFAULT_RESULT_URL="https://mnistvaultdemo.blob.core.windows.net/mnist-results/results/demo-result-1.json?se=2026-10-16T06%3A30Z&sp=cw&sv=2026-04-06&sr=b&sig=e4tkOqyeNUP%2Bx5fuQEHYbPaOOF%2F4oSxNSrWQjWxKhME%3D"
DEFAULT_RESULT_URL="https://mnistvaultdemo.blob.core.windows.net/mnist-results/results/logreg-2.json?se=2026-10-17T02%3A59Z&sp=cw&sv=2026-04-06&sr=b&sig=88rl31sD%2FPghbmR%2FJBpDfi7%2FUptZfr73l75N7%2BchTt8%3D"
# Read SAS (sp=r) for the same result blob — DEFAULT_RESULT_URL's SAS above is
# write-only. gov_layer fetches it for the UI's View Result
# (GET /v1/tee/jobs/{jobId}/result). Blank: View Result says it's not configured.
# RESULT_READ_URL=
RESULT_READ_URL="https://mnistvaultdemo.blob.core.windows.net/mnist-results/results/demo-result-1.json?se=2026-10-17T11%3A23Z&sp=r&sv=2026-04-06&sr=b&sig=tuOGXEPYoW%2B0lPEqh9k2DC7TxmVvt6apIDTUCfJVEXw%3D"

# SMTP config for the private-dataset FYI notice to the data provider (see
# services.sendPrivateDatasetNotice). Blank => notice is skipped with a
# logged warning; fill these in with a real SMTP server to enable it.
SMTP_HOST=
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# TEE/SMPC legacy general pathway (POST /contract — general_contract.go).
ORCH_PRIVATE_KEY=./keys/orch_private_key.pem
STORE_KEY=Zv58PzoUX9R11fHNHksA4NkvV6X+2WjL
STORE_PATH=./data/contracts.db

# TEE orchestrator (POST /v1/tee/... — tee_orchestrator.go). Real values for
# the pre-provisioned p3dx-anon-tee confidential VM in the TEE resource group.
TEE_AZURE_RG=TEE
TEE_VM_NAME=p3dx-anon-tee
TEE_VM_IP=40.80.82.162
TEE_ENCLAVE_PORT=4000
TEE_START_TIMEOUT_MS=300000
TEE_POLL_INTERVAL_MS=5000
TEE_OUTPUT_TIMEOUT_MS=60000

TEE_ATTESTATION_REQUIRED=true
# TODO: confirm the actual issuer once /attest runs once — the rejection
# error will report the guest's real iss claim if this default is wrong
# for the VM's region (centralindia).
TEE_MAA_ISSUERS=https://sharedeus2.eus2.attest.azure.net
TEE_ATTESTATION_TTL_MS=900000
TEE_ATTEST_TIMEOUT_MS=180000
TEE_CLOCK_LEEWAY_MS=60000

# Contract signing (FL, TEE, SMPC): gov_layer signs each contract hash with its
# own key pair (generated at GOV_SIGNING_KEY_PATH on first start), sends it to
# every data provider, and no FL session / TEE / SMPC run starts until each has
# signed that hash; each signature is verified against the provider's public
# key stored in this service's Postgres (table provider_public_keys).
REQUIRE_SIGNED_CONTRACT=true
GOV_SIGNING_KEY_PATH=./keys/governance_signing_key.pem
# Providers register that public key via p3dx-aaa, which forwards their own
# access token to PUT /provider-keys/{role}; it is validated against this JWKS —
# the dev Keycloak (iudx-v2). p3dx-aaa must log providers in through the same
# Keycloak, or their forwarded tokens are rejected.
# Local Keycloak (current) — dev tokens are still accepted via DATA_PROVIDER_JWKS_URL below:
PROVIDER_KEY_JWKS_URL=http://localhost:8080/realms/master/protocol/openid-connect/certs
# Dev Keycloak:
# PROVIDER_KEY_JWKS_URL=https://v2.dev.iudx.io/auth/realms/iudx-v2/protocol/openid-connect/certs
# Users and roles come from the dev Keycloak, read with a
# service-account client (client_credentials). The client's service account
# needs realm-management -> view-users in iudx-v2.
# USER_KEYCLOAK_BASE_URL=https://v2.dev.iudx.io/auth
# USER_KEYCLOAK_REALM=iudx-v2
# USER_KEYCLOAK_CLIENT_ID=p3dx-client
# USER_KEYCLOAK_CLIENT_SECRET=kImdcoqNs6kavXXJcwUNMwA8lbCTV2q3
# Realm role the job-approval data-provider check looks for (dev Keycloak calls it "provider").
DATA_PROVIDER_ROLE=provider

# DX catalogue for the job-approval data-provider check. POST
# /job/approval/data-provider must carry the data provider's own dev Keycloak
# token (Bearer); it is validated against DATA_PROVIDER_JWKS_URL (default: the
# USER_KEYCLOAK_BASE_URL/REALM certs above), must hold DATA_PROVIDER_ROLE, and
# is used to look each of their datasets up at CATALOGUE_BASE_URL/item?id=.
CATALOGUE_BASE_URL=https://v2.dev.iudx.io/controlplane/iudx/v2/cat
CATALOGUE_TIMEOUT_MS=10000

# Temporary: approve a job on its data-provider approval alone, without
# waiting for the infra-provider approval. Remove (or set true) to require both.
REQUIRE_INFRA_APPROVAL=false
# Dev:
# DATA_PROVIDER_JWKS_URL=https://v2.dev.iudx.io/auth/realms/iudx-v2/protocol/openid-connect/certs
# Local (current):
DATA_PROVIDER_JWKS_URL=http://localhost:8080/realms/master/protocol/openid-connect/certs

# Local (current) — for dev, comment these and uncomment the four USER_KEYCLOAK_* lines above:
USER_KEYCLOAK_BASE_URL=http://localhost:8080
USER_KEYCLOAK_REALM=master
USER_KEYCLOAK_ADMIN_USER=odin
USER_KEYCLOAK_ADMIN_PASSWORD=odin@123

# Validate users' access tokens against the local Keycloak they log in through
# (without this, it falls back to KEYCLOAK_BASE_URL/REALM above — the remote
# FL-receiver Keycloak — and every user token fails with "Invalid Keycloak token").
# To switch, comment one line and uncomment the other, then restart gov_layer.
# Local (current):
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/master/protocol/openid-connect/certs
# Dev:
# KEYCLOAK_JWKS_URL=https://v2.dev.iudx.io/auth/realms/iudx-v2/protocol/openid-connect/certs
# Both (comma-separated, local UI tokens and dev Postman tokens both validate):
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/master/protocol/openid-connect/certs,https://v2.dev.iudx.io/auth/realms/iudx-v2/protocol/openid-connect/certs

# Flotilla join gateway (POST /gateway-certs) — real Azure FL run, added 2026-10-22.
# Same values as the code defaults; the CA is generated at GOV_CA_CERT_PATH on first start.
FL_CONTRACT_VALIDITY=2160h
GOV_CA_CERT_PATH=./keys/governance_ca.pem
ORCHESTRATOR_CLIENT_ID=p3dx-fl-orchestrator
ORCHESTRATOR_ROLE=fl-orchestrator
FLOTILLA_VM_CLIENT_ID=flotilla-vm

# Added for the p3dx-aaa removal: FL session flow + FL VM credentials now live here.
ORCHESTRATOR_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_KEY=35cda1b5a46294cc7c8ceec7e6daf6f7e59597a8932fc626da4078b09d58ad82
FLOTILLA_VM_CLIENT_SECRET=07uUzUKf9Dc70jJAJtVuSWtbpAzNWN6gDd9XdAPPhKWL0blczx6x46DpIeKShYIxR3QS4C8DZfD3av5F9s2HgN
FL_VM_SWEEP_INTERVAL_MS=600000
